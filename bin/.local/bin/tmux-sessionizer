#!/usr/bin/env bash
# Pick a directory (zoxide history + the folders inside each of
# $TMUX_SESSIONIZER_DIRS, default ~/workspace) with fzf and attach to a tmux
# session named after it, creating the session if needed.
# Usage: tmux-sessionizer [dir]      (bound to `prefix f` in tmux)
set -euo pipefail

if [[ $# -ge 1 ]]; then
  dir=$1
else
  dir=$(
    { zoxide query -l 2>/dev/null || true
      for root in ${TMUX_SESSIONIZER_DIRS:-$HOME/workspace}; do
        find "$root" -mindepth 1 -maxdepth 1 -type d -not -name '.*' 2>/dev/null || true
      done
    } | awk '!seen[$0]++' | fzf --prompt="session> " --height=100% --reverse
  ) || exit 0
fi
[[ -d $dir ]] || { echo "not a directory: $dir" >&2; exit 1; }

name=$(basename "$dir" | tr '.:' '__')

if ! tmux has-session -t "=$name" 2>/dev/null; then
  tmux new-session -d -s "$name" -c "$dir"
fi

if [[ -n ${TMUX:-} ]]; then
  tmux switch-client -t "=$name"
else
  tmux attach-session -t "=$name"
fi
